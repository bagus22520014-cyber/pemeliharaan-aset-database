# Example environment variables for pemeliharaan-aset-database
# Copy to .env and edit values for your environment

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=secret
DB_NAME=pemeliharaan
DB_CONN_LIMIT=15
DB_QUEUE_LIMIT=0

# App
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# Rate limit (ms window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Worker tuning
WORKER_BATCH=200
